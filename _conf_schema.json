{
    "enable_group_owner": {
        "description": "是否允许群主使用功能",
        "type": "bool",
        "default": true
    },
    "enable_group_admin": {
        "description": "是否允许管理员使用功能",
        "type": "bool",
        "default": true
    },
    "show_server_version": {
        "description": "是否在卡片上显示服务器版本",
        "type": "bool",
        "default": false
    },
    "show_server_latency": {
        "description": "是否在卡片上显示服务器延迟",
        "type": "bool",
        "default": false
    },
    "super_admins": {
        "description": "超级管理员",
        "type": "list",
        "hint": "可管理白名单。填写用户 QQ 号（或其他平台唯一ID）",
        "default": [],
        "items": {
            "type": "string",
            "description": "用户ID"
        }
    },
    "whitelist_admins": {
        "description": "白名单管理员",
        "type": "list",
        "hint": "与群主、管理员拥有同等权限。填写用户 QQ 号（或其他平台唯一ID）",
        "default": [],
        "items": {
            "type": "string",
            "description": "用户ID"
        }
    },
    "blacklist": {
        "description": "黑名单",
        "type": "list",
        "hint": "黑名单中的用户无法使用插件的所有功能。填写用户 QQ 号（或其他平台唯一ID）",
        "default": [],
        "items": {
            "type": "string",
            "description": "用户ID"
        }
    },
    "default_api_port": {
        "description": "全局默认 API 端口",
        "type": "int",
        "default": 25566
    },
    "mod_api_token": {
        "description": "模组 API 鉴权 Token",
        "hint": "需要与配置文件中的 API_TOKEN 完全一致",
        "type": "string",
        "default": ""
    },
    "use_central_db": {
        "description": "是否启用中心数据库（D1）",
        "hint": "启用后绑定数据将写入云端数据库，实现跨服共享；关闭则回退到调用模组API的旧模式（各服务器独立）",
        "type": "bool",
        "default": false
    },
    "db_host": {
        "description": "TiDB 数据库主机地址",
        "hint": "格式：gateway01.ap-southeast-1.prod.aws.tidbcloud.com",
        "type": "string",
        "default": ""
    },
    "db_port": {
        "description": "TiDB 数据库端口（默认4000）",
        "type": "int",
        "default": 4000
    },
    "db_user": {
        "description": "数据库用户名",
        "hint": "完整用户名，含集群前缀",
        "type": "string",
        "default": ""
    },
    "db_password": {
        "description": "数据库密码",
        "type": "string",
        "default": ""
    },
    "db_name": {
        "description": "数据库名称（默认 qqbind_db）",
        "type": "string",
        "default": "qqbind_db"
    },
    "default_group_id": {
        "description": "默认群号",
        "hint": "仅在无法从事件获取时使用，通常留空即可",
        "type": "string",
        "default": ""
    }
}